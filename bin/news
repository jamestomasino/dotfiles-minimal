#!/bin/sh

server="$1"
newsfileroot="${HOME}/.jnewsrc"

# Detect hostname to decide server
myhost=$(hostname -f 2>/dev/null || hostname 2>/dev/null)

if [ "$server" = "usenet" ]; then
  newsfile="${newsfileroot}-usenet"
  NNTPSERVER="news.eternal-september.org"
  SLRNCONFIG="${HOME}/.slrnrc-usenet"
  export NNTPSERVER
elif [ "$myhost" = "cosmic.voyage" ]; then
  # Running on the server itself — connect locally over SSL
  newsfile="${newsfileroot}-cosmic"
  NNTPSERVER="snews://localhost:563"
  SLRNCONFIG="${HOME}/.slrn/slrnrc"
  export NNTPSERVER
else
  # Running remotely — connect to cosmic.voyage over SSL
  newsfile="${newsfileroot}-cosmic"
  NNTPSERVER="snews://cosmic.voyage:563"
  SLRNCONFIG="${HOME}/.slrn/slrnrc"
  export NNTPSERVER
fi

if [ ! -f "$newsfile" ]; then
  slrn --create -f "$newsfile" -i "${SLRNCONFIG}"
  slrn -d -f "$newsfile" -i "${SLRNCONFIG}"
fi
slrn -f "$newsfile" -i "${SLRNCONFIG}"
